# Local secrets for `wrangler dev` (gitignored — do not commit).
#   cp .dev.vars.example .dev.vars

ENVIRONMENT=development
JWT_SECRET=local-dev-only-change-me

# Production / staging secrets are set on Cloudflare, not here:
#   pnpm exec wrangler secret put JWT_SECRET
#   pnpm exec wrangler secret put JWT_SECRET --env staging
#   pnpm exec wrangler secret put JWT_SECRET --env production
